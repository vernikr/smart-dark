{
  "manifest_version": 3,
  "name": "Smart Dark",
  "version": "1.0.0",
  "description": "Dark theme for sites that lack one, plus smart dark conversion of large images.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "bg.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["common.js", "detect.js", "imagery.js", "lib/darkreader.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["data/fixes.json"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
